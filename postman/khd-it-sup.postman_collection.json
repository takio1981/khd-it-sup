          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/notifications/logs?limit=20", "host": ["{{baseUrl}}"], "path": ["notifications", "logs"], "query": [{ "key": "limit", "value": "20" }] }
          }
        }
      ]
    },
    {
