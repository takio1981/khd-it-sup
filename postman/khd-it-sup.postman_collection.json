          }
        },
        {
          "name": "Yearly Chart",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/dashboard/charts/yearly", "host": ["{{baseUrl}}"], "path": ["dashboard", "charts", "yearly"] }
          }
        },
        {
          "name": "Department Ranking",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/dashboard/charts/department-ranking?limit=10", "host": ["{{baseUrl}}"], "path": ["dashboard", "charts", "department-ranking"], "query": [{ "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Technician Workload",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/dashboard/charts/technician-workload", "host": ["{{baseUrl}}"], "path": ["dashboard", "charts", "technician-workload"] }
          }
        },
        {
          "name": "Analytics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/dashboard/analytics", "host": ["{{baseUrl}}"], "path": ["dashboard", "analytics"] }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{serverRoot}}/health", "host": ["{{serverRoot}}"], "path": ["health"] }
          },
          "auth": { "type": "noauth" }
        }
      ]
    }
  ]
}
