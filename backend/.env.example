# =====================================================================================
# KHD-IT-SUP Backend — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง — ห้าม commit .env เข้า git โดยเด็ดขาด
# =====================================================================================

# --- Application ---
NODE_ENV=development
# พอร์ตนี้ต้องตรงกับ DEV_BACKEND_PORT ใน .env (root) — ดู dev.bat
PORT=3500
APP_NAME=KHD-IT-SUP
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:4500

# --- Database (MariaDB) --- พอร์ตนี้ต้องตรงกับ DEV_MARIADB_PORT ใน .env (root) — dev.bat จะ start container ให้อัตโนมัติ
DATABASE_URL="mysql://khd_app:change-this-strong-password@localhost:3308/khd_it_sup"

# --- JWT ---
JWT_ACCESS_SECRET=change-this-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=khd_refresh_token

# --- Password / Security ---
BCRYPT_SALT_ROUNDS=12
QR_AES_SECRET=change-this-32-byte-aes-secret!!  # ต้องยาวพอดี 32 ตัวอักษรสำหรับ AES-256

# --- Rate Limit ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# --- PIN Quick Login (device-bound) ---
PIN_DEVICE_COOKIE_NAME=khd_pin_device
PIN_DEVICE_TTL=90d
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
PIN_REVOKE_AFTER_ATTEMPTS=10
PIN_LOGIN_RATE_LIMIT_MAX=30

# --- File Upload ---
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# --- Mailer (Gmail SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=KHD IT Service Desk
SMTP_FROM_EMAIL=your-email@gmail.com

# --- Telegram Bot (Phase 10+) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# --- LINE Messaging API (Phase 10+) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Frontend URL (ใช้สร้างลิงก์ QR / อีเมล) — ต้องมี /khd-it-sup ต่อท้ายเสมอ (ตรงกับ ng serve --serve-path) ---
FRONTEND_BASE_URL=http://localhost:4500/khd-it-sup

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=./logs
