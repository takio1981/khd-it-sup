# =====================================================================================
# KHD-IT-SUP Backend — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง — ห้าม commit .env เข้า git โดยเด็ดขาด
# =====================================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
APP_NAME=KHD-IT-SUP
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:4200

# --- Database (MariaDB) ---
DATABASE_URL="mysql://khd_app:changeme@localhost:3306/khd_it_sup"

# --- JWT ---
JWT_ACCESS_SECRET=change-this-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=khd_refresh_token

# --- Password / Security ---
BCRYPT_SALT_ROUNDS=12
QR_AES_SECRET=change-this-32-byte-aes-secret!!  # ต้องยาวพอดี 32 ตัวอักษรสำหรับ AES-256

# --- Rate Limit ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# --- File Upload ---
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# --- Mailer (Gmail SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=KHD IT Service Desk
SMTP_FROM_EMAIL=your-email@gmail.com

# --- Telegram Bot (Phase 10+) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# --- LINE Messaging API (Phase 10+) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Frontend URL (ใช้สร้างลิงก์ QR / อีเมล) ---
FRONTEND_BASE_URL=http://localhost:4200

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=./logs
