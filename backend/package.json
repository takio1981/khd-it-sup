    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
