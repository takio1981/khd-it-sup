# =====================================================================================
# KHD-IT-SUP — Root Environment File (ใช้โดย docker-compose.yml)
# คัดลอกเป็น .env แล้วกรอกค่าจริงก่อน `docker compose up`
# หมายเหตุ: backend/.env.example และ frontend/environments/*.ts มีค่าคู่ขนานสำหรับรันนอก Docker
# =====================================================================================

# --- MariaDB ---
MARIADB_DATABASE=khd_it_sup
MARIADB_USER=khd_app
MARIADB_PASSWORD=change-this-strong-password
MARIADB_ROOT_PASSWORD=change-this-root-password
MARIADB_PORT=3306

# --- Backend ---
BACKEND_PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost
# ทั้งแอปอยู่ใต้ path prefix /khd-it-sup/ (ดู docker/nginx/nginx.conf) เพื่อให้ deploy ร่วมกับ
# project อื่นบน domain เดียวกันได้ — ถ้าเปลี่ยน prefix ต้องแก้ทั้ง nginx.conf และค่านี้ให้ตรงกัน
FRONTEND_BASE_URL=http://localhost/khd-it-sup

JWT_ACCESS_SECRET=change-this-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

QR_AES_SECRET=change-this-32-byte-aes-secret!!

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=KHD IT Service Desk
SMTP_FROM_EMAIL=your-email@gmail.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Frontend ---
FRONTEND_PORT=4200

# --- Nginx (reverse proxy) ---
NGINX_PORT=80
NGINX_SSL_PORT=443
