# =====================================================================================
# KHD-IT-SUP — Root Environment File (ใช้โดย docker-compose.yml)
# คัดลอกเป็น .env แล้วกรอกค่าจริงก่อน `docker compose up`
# หมายเหตุ: backend/.env.example และ frontend/environments/*.ts มีค่าคู่ขนานสำหรับรันนอก Docker
# =====================================================================================

# --- MariaDB ---
MARIADB_DATABASE=khd_it_sup
MARIADB_USER=khd_app
MARIADB_PASSWORD=change-this-strong-password
MARIADB_ROOT_PASSWORD=change-this-root-password
MARIADB_PORT=3306

# --- Backend ---
API_PREFIX=/api/v1
CORS_ORIGIN=https://localhost
# ทั้งแอปอยู่ใต้ path prefix /khd-it-sup/ (ดู docker/nginx/nginx.conf) เพื่อให้ deploy ร่วมกับ
# project อื่นบน domain เดียวกันได้ — ถ้าเปลี่ยน prefix ต้องแก้ทั้ง nginx.conf และค่านี้ให้ตรงกัน
# ต้องเป็น https:// เสมอ — nginx บังคับ redirect ทุก request ไป HTTPS (จำเป็นสำหรับกล้อง/QR scanner)
FRONTEND_BASE_URL=https://localhost/khd-it-sup

JWT_ACCESS_SECRET=change-this-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

QR_AES_SECRET=change-this-32-byte-aes-secret!!

# --- Rate Limiting ---
# หมายเหตุสำคัญ: ถ้ารัน backend หลัง Docker Desktop บน Windows (WSL2) ทุก request ที่มาถึง container
# (ไม่ว่าจะมาจากเครื่อง server เอง หรือมือถือ/เครื่องอื่นบน LAN ผ่าน reverse proxy) มักถูก NAT ให้เห็นเป็น
# IP เดียวกันหมด (gateway ของ docker network) — แปลว่า budget นี้ถูก "ใช้ร่วมกัน" ทั้งหน่วยงาน ไม่ใช่แยกตาม
# ผู้ใช้แต่ละคนจริง ๆ ต้องตั้งค่าให้สูงพอสำหรับผู้ใช้พร้อมกันหลายคน (หน้า dashboard เดียวยิง request ~15-20
# ครั้งต่อครั้งโหลด) ไม่ใช่คิดในมุม "300 ครั้งต่อผู้ใช้ 1 คนก็เกินพอแล้ว"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
LOGIN_RATE_LIMIT_MAX=50
PIN_LOGIN_RATE_LIMIT_MAX=100

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=KHD IT Service Desk
SMTP_FROM_EMAIL=your-email@gmail.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Nginx (reverse proxy) ---
NGINX_PORT=80
NGINX_SSL_PORT=443

# --- Local dev servers (dev.bat) — ไม่เกี่ยวกับ docker-compose.yml (production) ด้านบน ---
# ใช้เมื่อรัน backend/frontend นอก Docker เพื่อแก้โค้ด+ทดสอบ ก่อน deploy ขึ้น production จริงผ่าน deploy-prod.bat
# ตั้งเป็นพอร์ตที่ไม่ชนกับ container อื่นที่รันอยู่บนเครื่อง (เช็คด้วย `docker ps` ก่อนเปลี่ยนถ้าจำเป็น)
DEV_BACKEND_PORT=3500
DEV_FRONTEND_PORT=4600
DEV_MARIADB_PORT=3308
